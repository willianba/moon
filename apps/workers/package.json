{
  "name": "@moon/workers",
  "version": "1.0.0",
  "description": "Background job workers with BullMQ",
  "private": true,
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./queues": {
      "types": "./src/queues/index.ts",
      "default": "./src/queues/index.ts"
    }
  },
  "scripts": {
    "check": "tsc --noEmit",
    "start": "bun run src/worker.ts",
    "dev": "bun --watch run src/worker.ts"
  },
  "dependencies": {
    "bullmq": "^5.77.1",
    "ioredis": "^5.10.1"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14"
  }
}
