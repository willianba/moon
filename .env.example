# Local dev: use an ABSOLUTE path so all processes (web, workers, drizzle-kit) share the same file
# TURSO_DATABASE_URL=file:/absolute/path/to/your/project/local.db
#
# Production (Turso Cloud): use your libsql URL + auth token
# TURSO_DATABASE_URL=libsql://<db-name>.turso.io
# TURSO_AUTH_TOKEN=
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
