{
  "name": "moon-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "devDependencies": {
    "@biomejs/biome": "^2.3.8",
    "@types/bun": "latest",
    "husky": "^9.1.7",
    "lint-staged": "^15.4.3",
    "tsconfig-moon": "^1.3.0",
    "typescript": "~5.8.3",
    "ultracite": "^6.3.10"
  },
  "optionalDependencies": {
    "@rollup/rollup-darwin-arm64": "^4.53.3",
    "@rollup/rollup-darwin-x64": "^4.53.3",
    "@rollup/rollup-linux-x64-gnu": "^4.53.3"
  },
  "scripts": {
    "prepare": "husky"
  },
  "trustedDependencies": [
    "@rollup/rollup-darwin-x64",
    "@rollup/rollup-darwin-arm64",
    "@rollup/rollup-linux-x64-gnu",
    "esbuild",
    "svelte-preprocess"
  ],
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,css,svelte}": [
      "biome check --write --no-errors-on-unmatched"
    ]
  }
}
